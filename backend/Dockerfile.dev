# Use Node.js 24 LTS
FROM node:24-alpine

# Install curl for health checks
RUN apk add --no-cache curl

# Set working directory
WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm ci

# Copy source code
COPY . .

# Expose ports
EXPOSE 3000 9229

# Start the development server with hot reloading
CMD ["npm", "run", "dev"] 