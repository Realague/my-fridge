{
  "name": "backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node tools/copy-assets.cjs",
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "debug": "nodemon --inspect=0.0.0.0:9229 src/index.ts",
    "debug-brk": "nodemon --inspect-brk=0.0.0.0:9229 src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:undo:all": "sequelize-cli db:migrate:undo:all",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:migration:create": "sequelize-cli migration:generate --name",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:undo": "sequelize-cli db:seed:undo:all",
    "db:create": "sequelize-cli db:create",
    "db:drop": "sequelize-cli db:drop",
    "migrate:smart": "npm run build && node -e \"require('./dist/utils/migrationStrategy').executeSmartMigration().then(r => console.log('Result:', r)).catch(console.error)\"",
    "migrate:production": "NODE_ENV=production FORCE_PRODUCTION_MIGRATION=true npm run migrate:smart",
    "migrate:validate": "npm run build && node -e \"require('./dist/utils/migrationManager').migrationManager.validateMigrations().then(r => console.log('Validation:', r)).catch(console.error)\"",
    "dev:no-migrate": "AUTO_MIGRATE=false nodemon src/index.ts",
    "dev:manual": "NODE_ENV=manual nodemon src/index.ts",
    "db:create:script": "ts-node src/scripts/createDatabase.ts",
    "seed:items": "ts-node src/scripts/seedItemsFromCSV.ts",
    "seed:items:staging": "ts-node src/scripts/seedItemsFromCSV.ts my_fridge_db_staging 5433",
    "seed:items:incremental": "ts-node src/scripts/seedItemsIncremental.ts",
    "brands:logos": "ts-node src/scripts/downloadBrandLogos.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "sequelize",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "description": "Backend API with Express, TypeScript, Sequelize and PostgreSQL",
  "dependencies": {
    "@cloudinary/react": "^1.14.3",
    "@cloudinary/url-gen": "^1.22.0",
    "@types/express": "^4.17.23",
    "@types/express-session": "^1.18.2",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "axios": "^1.13.2",
    "cheerio": "^1.1.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "google-auth-library": "^10.1.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.16.0",
    "sequelize": "^6.37.7",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^24.0.1",
    "@types/pg": "^8.15.4",
    "@types/web-push": "^3.6.4",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
