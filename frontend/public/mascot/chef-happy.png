<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Fresh — Sorties de stock</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #fdf8ed;
    --card: #ffffff;
    --sub: #f6efde;
    --ink: #1a1d1a;
    --ink-2: #5e6760;
    --ink-3: #9ba59f;
    --rule: #ece4d2;
    --green: #2bb673;
    --green-soft: #d6f3e3;
    --green-deep: #1f9c5e;
    --orange: #ff7a3a;
    --orange-soft: #ffe0cc;
    --red: #ef4a5a;
    --red-soft: #ffd9de;
    --yellow: #ffc839;
    --yellow-soft: #fff1c4;
    --blue: #4f8ef5;
    --blue-soft: #dae9ff;
    --purple: #8c6df0;
    --purple-soft: #e4dafa;
    --font-display: "DM Sans", system-ui, sans-serif;
    --font-body: "Inter", ui-sans-serif, system-ui, sans-serif;
    --bezel: #1a1d1a;
    --bezel-2: #3a3d3a;
    --island: #1a1d1a;
  }

  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    background: #e8e0cf;
    color: var(--ink);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
    display: flex; align-items: center; justify-content: center;
    padding: 36px 20px;
    gap: 56px;
    flex-wrap: wrap;
  }

  /* ────── PHONE ─────────────────────────────────────────────────── */
  .phone {
    width: 390px;
    background: var(--bg);
    border-radius: 52px;
    padding: 8px;
    box-shadow:
      0 0 0 11px var(--bezel),
      0 0 0 12px var(--bezel-2),
      0 30px 60px -20px rgba(0,0,0,.32),
      0 18px 36px -22px rgba(0,0,0,.22);
    position: relative;
    flex-shrink: 0;
  }
  .scr {
    background: var(--bg);
    border-radius: 44px;
    overflow: hidden;
    position: relative;
    height: 844px;
    display: flex; flex-direction: column;
  }

  /* ────── STATUS BAR ───────────────────────────────────────────── */
  .statusbar {
    height: 50px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 30px;
    font-family: var(--font-display); font-size: 15px; font-weight: 700;
    color: var(--ink);
    position: relative; z-index: 5;
  }
  .statusbar .time { font-variant-numeric: tabular-nums; }
  .statusbar .ind { display: flex; gap: 6px; align-items: center; }
  .statusbar::after {
    content: ""; position: absolute;
    top: 9px; left: 50%; transform: translateX(-50%);
    width: 92px; height: 30px; border-radius: 999px; background: var(--island);
  }

  /* ────── NAV ──────────────────────────────────────────────────── */
  .nav {
    display: flex; align-items: center; gap: 14px;
    padding: 4px 20px 12px; flex-shrink: 0; background: var(--bg);
  }
  .nav .back {
    width: 36px; height: 36px; border-radius: 12px; background: var(--card);
    display: flex; align-items: center; justify-content: center; color: var(--ink);
    box-shadow: 0 1px 2px rgba(0,0,0,.04); flex-shrink: 0;
  }
  .nav .title-wrap { flex: 1; min-width: 0; }
  .nav .title {
    font-family: var(--font-display); font-weight: 700; font-size: 19px;
    color: var(--ink); line-height: 1.1; letter-spacing: -0.02em;
    display: flex; align-items: center; gap: 8px;
  }
  .nav .sub { font-size: 12.5px; color: var(--ink-2); margin-top: 2px; }
  .nav .fab-add {
    width: 38px; height: 38px; border-radius: 12px; border: 0;
    background: var(--green); color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 4px 10px rgba(43,182,115,.35); flex-shrink: 0;
  }

  /* ────── BODY (scroll) ────────────────────────────────────────── */
  .body {
    flex: 1; min-height: 0; overflow-y: auto;
    padding: 4px 18px 20px;
    scrollbar-width: none;
  }
  .body::-webkit-scrollbar { display: none; }

  /* ────── SUGGESTION BANNER ────────────────────────────────────── */
  .suggest {
    background: linear-gradient(180deg, #fff6e6 0%, var(--card) 62%);
    border: 1px solid #ffe7b3;
    border-radius: 20px;
    padding: 14px 14px 14px 14px;
    margin-bottom: 16px;
    box-shadow: 0 1px 2px rgba(0,0,0,.03), 0 8px 20px rgba(255,160,40,.10);
  }
  .suggest .top { display: flex; gap: 12px; align-items: flex-start; }
  .suggest .masc {
    width: 46px; height: 46px; border-radius: 14px; flex-shrink: 0;
    background: var(--orange-soft);
    display: flex; align-items: center; justify-content: center; overflow: hidden;
  }
  .suggest .masc img { width: 40px; height: 40px; object-fit: contain; }
  .suggest .txt { flex: 1; min-width: 0; }
  .suggest .h {
    font-family: var(--font-display); font-weight: 700; font-size: 14px;
    color: var(--ink); line-height: 1.25;
  }
  .suggest .sub { font-size: 12px; color: var(--ink-2); margin-top: 3px; line-height: 1.4; }
  .suggest .acts { display: flex; gap: 8px; margin-top: 13px; flex-wrap: wrap; }
  .suggest .acts.stack { flex-direction: column; }
  .s-btn {
    appearance: none; border: 0; cursor: pointer;
    font-family: var(--font-display); font-weight: 700; font-size: 12.5px;
    border-radius: 999px; padding: 9px 14px;
    display: inline-flex; align-items: center; justify-content: center; gap: 6px;
  }
  .s-btn.full { width: 100%; }
  .s-btn.primary { background: var(--ink); color: var(--bg); }
  .s-btn.wasted { background: var(--red); color: #fff; }
  .s-btn.consumed { background: var(--green-soft); color: var(--green-deep); }
  .s-btn.ghost { background: transparent; color: var(--ink-2); }
  .s-btn.ghost:active { background: var(--sub); }

  .suggest-list { display: none; margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--rule); flex-direction: column; gap: 12px; }
  .suggest.open .suggest-list { display: flex; }
  .suggest.open .chev { transform: rotate(180deg); }
  .chev { transition: transform .2s; color: var(--ink-3); }
  .si-row { display: flex; align-items: center; gap: 10px; }
  .si-row .ic {
    width: 36px; height: 36px; border-radius: 11px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .si-row .nm { font-family: var(--font-display); font-weight: 700; font-size: 13px; line-height: 1.15; }
  .si-row .meta { font-size: 11px; color: var(--ink-2); margin-top: 1px; }
  .si-row .mini { display: flex; gap: 6px; margin-left: auto; }
  .mini-b {
    width: 32px; height: 32px; border-radius: 10px; border: 0; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .mini-b.wasted { background: var(--red-soft); color: var(--red); }
  .mini-b.consumed { background: var(--green-soft); color: var(--green-deep); }
  .mini-b.ignore { background: var(--sub); color: var(--ink-3); }

  /* ────── SECTION LABEL ────────────────────────────────────────── */
  .sec-lbl {
    font-family: var(--font-display); font-size: 11px; font-weight: 800;
    letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-2);
    margin: 6px 4px 10px; display: flex; align-items: center; gap: 8px;
  }
  .sec-lbl .count { margin-left: auto; font-weight: 600; letter-spacing: 0; text-transform: none; font-size: 11px; color: var(--ink-3); }

  /* ────── SWIPE PRODUCT ────────────────────────────────────────── */
  .swipe {
    position: relative; border-radius: 18px; overflow: hidden;
    margin-bottom: 10px;
  }
  .swipe .behind {
    position: absolute; inset: 0; border-radius: 18px;
    background: var(--green);
    display: flex; align-items: center; justify-content: flex-end;
    padding-right: 26px; gap: 8px;
    color: #fff; font-family: var(--font-display); font-weight: 800; font-size: 14px;
  }
  .swipe .behind .ring {
    width: 38px; height: 38px; border-radius: 50%;
    background: rgba(255,255,255,.22);
    display: flex; align-items: center; justify-content: center;
  }
  .prod {
    position: relative; z-index: 1;
    background: var(--card); border-radius: 18px; padding: 12px;
    display: flex; gap: 12px; align-items: flex-start;
    box-shadow: 0 1px 2px rgba(0,0,0,.03), 0 4px 12px rgba(0,0,0,.04);
    touch-action: pan-y; cursor: grab;
    transition: transform .26s cubic-bezier(.2,.8,.2,1);
  }
  .prod:active { cursor: grabbing; }
  .prod .thumb {
    width: 52px; height: 52px; border-radius: 14px; background: var(--sub);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0; overflow: hidden;
  }
  .prod .info { flex: 1; min-width: 0; }
  .prod .nm { font-family: var(--font-display); font-weight: 700; font-size: 14.5px; line-height: 1.15; color: var(--ink); }
  .prod .pills { display: flex; gap: 6px; margin-top: 5px; flex-wrap: wrap; }
  .prod .meta { font-size: 11px; color: var(--ink-2); margin-top: 6px; line-height: 1.5; display: flex; flex-direction: column; gap: 1px; }
  .prod .meta .li { display: flex; align-items: center; gap: 5px; }
  .qty-tag {
    font-family: var(--font-display); font-weight: 800; font-size: 15px;
    color: var(--ink); display: flex; align-items: baseline; gap: 3px;
    flex-shrink: 0;
  }
  .qty-tag .u { font-size: 11px; font-weight: 600; color: var(--ink-2); }

  .pill {
    display: inline-flex; align-items: center; gap: 4px;
    padding: 3px 9px; border-radius: 999px;
    font-family: var(--font-display); font-size: 10.5px; font-weight: 700;
  }
  .pill.green { background: var(--green-soft); color: var(--green-deep); }
  .pill.red { background: var(--red); color: #fff; }
  .pill.orange { background: var(--orange); color: #fff; }
  .pill.yellow { background: var(--yellow-soft); color: #8a6500; }
  .pill.blue { background: var(--blue-soft); color: #1d4dab; }
  .pill.purple { background: var(--purple-soft); color: #5536c7; }

  .lic { width: 1em; height: 1em; vertical-align: -0.13em; }
  .thumb .lic, .si-row .ic .lic { vertical-align: middle; }

  .swipe.removing { animation: collapse .34s forwards ease; }
  @keyframes collapse {
    to { opacity: 0; transform: translateX(-40px) scale(.92); height: 0; margin-bottom: 0; padding: 0; }
  }

  .swipe-hint {
    text-align: center; font-size: 11px; color: var(--ink-3);
    font-family: var(--font-display); font-weight: 600;
    margin: 2px 0 16px; display: flex; align-items: center; justify-content: center; gap: 6px;
  }

  /* ────── TAB BAR ──────────────────────────────────────────────── */
  .tabbar {
    background: var(--card); border-top: 1px solid var(--rule);
    padding: 10px 8px 28px; flex-shrink: 0;
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 4px;
  }
  .tabbar .tab {
    display: flex; flex-direction: column; align-items: center; gap: 3px;
    padding: 8px 0 6px; color: var(--ink-3); border-radius: 14px;
  }
  .tabbar .tab.active { background: var(--green-soft); color: var(--green-deep); }
  .tabbar .tab .lbl { font-family: var(--font-display); font-size: 10.5px; font-weight: 600; }

  /* ────── OVERLAY / SHEETS ─────────────────────────────────────── */
  .scrim {
    position: absolute; inset: 0; z-index: 30;
    background: rgba(20,22,20,.42);
    opacity: 0; pointer-events: none; transition: opacity .26s;
  }
  .scrim.show { opacity: 1; pointer-events: auto; }

  .sheet {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 40;
    background: var(--card);
    border-radius: 28px 28px 0 0;
    padding: 10px 20px calc(20px + env(safe-area-inset-bottom));
    transform: translateY(110%); transition: transform .32s cubic-bezier(.2,.85,.25,1);
    box-shadow: 0 -10px 40px rgba(0,0,0,.18);
  }
  .sheet.show { transform: translateY(0); }
  .sheet .grab { width: 38px; height: 5px; border-radius: 999px; background: var(--rule); margin: 6px auto 16px; }

  .sheet-head { display: flex; gap: 12px; align-items: center; margin-bottom: 4px; }
  .sheet-head .thumb {
    width: 48px; height: 48px; border-radius: 14px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .sheet-head .nm { font-family: var(--font-display); font-weight: 700; font-size: 17px; letter-spacing: -0.01em; }
  .sheet-head .meta { font-size: 12px; color: var(--ink-2); margin-top: 2px; }

  /* quantity stepper */
  .qty-block { margin: 20px 0 18px; }
  .qty-block .lbl { font-family: var(--font-display); font-weight: 700; font-size: 12.5px; color: var(--ink-2); margin-bottom: 9px; }
  .stepper {
    display: flex; align-items: center; gap: 14px;
    background: var(--sub); border-radius: 16px; padding: 8px 12px;
  }
  .stepper .sbtn {
    width: 40px; height: 40px; border-radius: 12px; border: 0; cursor: pointer;
    background: var(--card); color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.05);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; font-family: var(--font-display);
  }
  .stepper .sbtn:disabled { opacity: .4; cursor: default; }
  .stepper .val { flex: 1; text-align: center; }
  .stepper .val .n { font-family: var(--font-display); font-weight: 800; font-size: 26px; line-height: 1; }
  .stepper .val .of { font-size: 11.5px; color: var(--ink-2); margin-top: 3px; }
  .stepper .all {
    border: 0; background: transparent; cursor: pointer;
    font-family: var(--font-display); font-weight: 700; font-size: 11.5px;
    color: var(--green-deep); padding: 6px 4px;
  }

  .action-grid { display: flex; flex-direction: column; gap: 10px; }
  .act-btn {
    appearance: none; border: 0; cursor: pointer; text-align: left;
    border-radius: 16px; padding: 14px 16px;
    display: flex; align-items: center; gap: 13px;
    font-family: var(--font-display);
  }
  .act-btn .ai {
    width: 40px; height: 40px; border-radius: 12px; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center;
  }
  .act-btn .at { display: block; font-weight: 700; font-size: 15px; line-height: 1.1; }
  .act-btn .as { display: block; font-size: 11.5px; font-weight: 500; margin-top: 3px; opacity: .85; }
  .act-btn .arrow { margin-left: auto; opacity: .5; }
  .act-btn.consumed { background: var(--green); color: #fff; }
  .act-btn.consumed .ai { background: rgba(255,255,255,.2); }
  .act-btn.wasted { background: var(--card); color: var(--ink); border: 1.5px solid var(--red-soft); }
  .act-btn.wasted .ai { background: var(--red-soft); color: var(--red); }
  .act-btn.removed { background: var(--card); color: var(--ink); border: 1.5px solid var(--rule); }
  .act-btn.removed .ai { background: var(--sub); color: var(--ink-2); }

  /* long-press menu */
  .menu {
    position: absolute; z-index: 45;
    background: var(--card); border-radius: 18px;
    box-shadow: 0 18px 50px rgba(0,0,0,.22), 0 2px 8px rgba(0,0,0,.10);
    padding: 6px; width: 220px;
    transform: scale(.9); opacity: 0; pointer-events: none;
    transition: transform .16s, opacity .16s; transform-origin: top center;
  }
  .menu.show { transform: scale(1); opacity: 1; pointer-events: auto; }
  .menu .mi {
    display: flex; align-items: center; gap: 11px;
    padding: 11px 12px; border-radius: 12px; cursor: pointer;
    font-family: var(--font-display); font-weight: 600; font-size: 14px; color: var(--ink);
  }
  .menu .mi:active { background: var(--sub); }
  .menu .mi .mc { width: 30px; height: 30px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
  .menu .mi.consumed .mc { background: var(--green-soft); color: var(--green-deep); }
  .menu .mi.wasted .mc { background: var(--red-soft); color: var(--red); }
  .menu .mi.removed .mc { background: var(--sub); color: var(--ink-2); }
  .menu .sep { height: 1px; background: var(--rule); margin: 4px 8px; }

  /* ────── TOAST ────────────────────────────────────────────────── */
  .toast-wrap {
    position: absolute; left: 16px; right: 16px; bottom: 96px; z-index: 50;
    display: flex; flex-direction: column; gap: 8px; pointer-events: none;
  }
  .toast {
    background: var(--ink); color: #fff;
    border-radius: 16px; padding: 12px 12px 12px 16px;
    display: flex; align-items: center; gap: 12px;
    box-shadow: 0 12px 30px rgba(0,0,0,.28);
    pointer-events: auto;
    transform: translateY(20px); opacity: 0;
    transition: transform .28s cubic-bezier(.2,.85,.25,1), opacity .28s;
  }
  .toast.show { transform: translateY(0); opacity: 1; }
  .toast .ti {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
    display: flex; align-items: center; justify-content: center; position: relative;
  }
  .toast .ti.consumed { background: rgba(43,182,115,.25); color: #7ef0b4; }
  .toast .ti.wasted { background: rgba(239,74,90,.25); color: #ff8a96; }
  .toast .ti.removed { background: rgba(255,255,255,.16); color: #fff; }
  .toast .tt { flex: 1; min-width: 0; }
  .toast .tt .l1 { font-family: var(--font-display); font-weight: 700; font-size: 13.5px; line-height: 1.2; }
  .toast .tt .l2 { font-size: 11px; color: rgba(255,255,255,.6); margin-top: 1px; }
  .toast .undo {
    border: 0; background: rgba(255,255,255,.12); color: #fff; cursor: pointer;
    font-family: var(--font-display); font-weight: 700; font-size: 12.5px;
    padding: 9px 13px; border-radius: 999px;
    display: flex; align-items: center; gap: 6px; flex-shrink: 0;
  }
  .toast .undo .ring { position: relative; width: 16px; height: 16px; }
  .toast .undo svg { transform: rotate(-90deg); }
  .toast .undo .ring circle { fill: none; stroke-width: 2.5; }
  .toast .undo .ring .bg { stroke: rgba(255,255,255,.22); }
  .toast .undo .ring .fg { stroke: #fff; stroke-linecap: round; transition: stroke-dashoffset 1s linear; }
</style>
</head>
<body>

<div class="phone">
  <div class="scr" id="scr">
    <div class="statusbar">
      <span class="time">9:41</span>
      <span class="ind">
        <svg width="18" height="11" viewBox="0 0 18 11" fill="currentColor"><path d="M0 8h2v3H0zM4 6h2v5H4zM8 4h2v7H8zM12 2h2v9h-2zM16 0h2v11h-2z"/></svg>
        <svg width="16" height="11" viewBox="0 0 16 11" fill="none" stroke="currentColor" stroke-width="1"><path d="M8 3a8 8 0 0 1 5.5 2.2M8 6a5 5 0 0 1 3.5 1.4M8 9.5a1 1 0 0 1 .8.4"/></svg>
        <svg width="26" height="12" viewBox="0 0 26 12" fill="none"><rect x="1" y="1" width="20" height="10" rx="2.5" stroke="currentColor" stroke-width="1"/><rect x="2.5" y="2.5" width="17" height="7" rx="1.5" fill="currentColor"/><rect x="22" y="4" width="2" height="4" rx="0.7" fill="currentColor"/></svg>
      </span>
    </div>

    <div class="nav">
      <div class="back"><i data-lucide="chevron-left" class="lic"></i></div>
      <div class="title-wrap">
        <div class="title">
          <span style="font-size: 21px;"><i data-lucide="refrigerator" class="lic" style="color:#1f9c5e"></i></span>
          Réfrigérateur
        </div>
        <div class="sub" id="navSub">5 articles · Maison Dubois</div>
      </div>
      <button class="fab-add"><i data-lucide="plus" class="lic"></i></button>
    </div>

    <div class="body" id="body">
      <!-- suggestion banner injected here -->
      <div id="suggestSlot"></div>

      <div class="sec-lbl">Au frigo <span class="count" id="secCount">5 articles</span></div>
      <div id="list"></div>

      <div class="swipe-hint">
        <i data-lucide="arrow-left" class="lic"></i>
        Glisse vers la gauche pour marquer « Consommé »
      </div>
    </div>

    <div class="tabbar">
      <div class="tab"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12 12 3l9 9v9a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg><span class="lbl">Accueil</span></div>
      <div class="tab active"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="7" r="3"/><circle cx="17" cy="11" r="3"/><circle cx="9" cy="16" r="3"/></svg><span class="lbl">Stock</span></div>
      <div class="tab"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 4h2l2 11h12l2-7H7"/><circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/></svg><span class="lbl">Courses</span></div>
      <div class="tab"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5a2 2 0 0 1 2-2h6v18H5a2 2 0 0 1-2-2zM21 5a2 2 0 0 0-2-2h-6v18h6a2 2 0 0 0 2-2z"/></svg><span class="lbl">Recettes</span></div>
      <div class="tab"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/></svg><span class="lbl">Plus</span></div>
    </div>

    <!-- overlays -->
    <div class="scrim" id="scrim"></div>
    <div class="menu" id="menu"></div>
    <div class="sheet" id="sheet"></div>
    <div class="toast-wrap" id="toastWrap"></div>
  </div>
</div>

<script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
<script src="sorties-stock.js"></script>
</body>
</html>
